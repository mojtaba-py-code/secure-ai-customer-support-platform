# AegisSupport AI - example configuration. Do not copy this file by hand; generate a real one:
#
#     aegis init-env              # local development (SQLite, embedded index, fresh secrets)
#     aegis init-env --docker     # the variables docker-compose.yml needs (fresh secrets)
#
# Never commit a real .env. In production, inject secrets from a secret manager (Docker or
# Kubernetes secrets, HashiCorp Vault, AWS Secrets Manager, Azure Key Vault ...) - either as
# environment variables or as files in AEGIS_SECRETS_DIR (one file per variable name).
# An empty value means "not set": the default applies. Every setting: docs/configuration.md.

# --- environment ---------------------------------------------------------------------------------
AEGIS_ENV=development                      # development | test | staging | production
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=true

# --- required secrets (`aegis generate-secrets` prints fresh values) --------------------------------
AEGIS_JWT_SECRET=
AEGIS_FIELD_ENCRYPTION_KEYS=               # comma-separated Fernet keys; the first one encrypts
AEGIS_METRICS_TOKEN=                       # >= 16 characters; required in production

# --- storage (local development) --------------------------------------------------------------------
# SQLite is for local development and tests only; production requires PostgreSQL.
AEGIS_DATABASE_URL=sqlite+aiosqlite:///./var/aegis.db
AEGIS_QDRANT_LOCATION=var/qdrant           # embedded vector index when AEGIS_QDRANT_URL is unset
# AEGIS_REDIS_URL=redis://aegis:<password>@localhost:6379/0
# AEGIS_QDRANT_URL=https://qdrant.internal:6333
# AEGIS_QDRANT_API_KEY=

# --- storage (PostgreSQL outside Docker) ----------------------------------------------------------------
# The application connects as the restricted runtime role; migrations use the schema owner.
# AEGIS_DATABASE_URL=postgresql+asyncpg://aegis_app:<password>@localhost:5432/aegis
# AEGIS_MIGRATION_DATABASE_URL=postgresql+asyncpg://aegis_owner:<password>@localhost:5432/aegis
# AEGIS_DB_APP_ROLE=aegis_app

# --- http --------------------------------------------------------------------------------------------------
AEGIS_ALLOWED_HOSTS=localhost,127.0.0.1
AEGIS_CORS_ORIGINS=
AEGIS_TRUSTED_PROXIES=
AEGIS_HSTS_ENABLED=false

# --- language model ------------------------------------------------------------------------------------------
# "offline" runs the whole pipeline with a deterministic, grounded stand-in model (no API key).
AEGIS_LLM_PROVIDER=offline                 # offline | anthropic
# AEGIS_ANTHROPIC_API_KEY=
# AEGIS_LLM_AGENT_MODEL=claude-opus-5-5
# AEGIS_LLM_CLASSIFIER_MODEL=claude-haiku-4-5
# AEGIS_LLM_AGENT_EFFORT=low
AEGIS_LLM_USER_DAILY_TOKEN_BUDGET=200000
AEGIS_LLM_GLOBAL_DAILY_COST_LIMIT_USD=25

# --- embeddings ------------------------------------------------------------------------------------------------
AEGIS_EMBEDDING_PROVIDER=hashing           # hashing (local, offline) | voyage
# AEGIS_VOYAGE_API_KEY=
# AEGIS_EMBEDDING_DIMENSIONS=1024          # must match the collection; re-index after changing

# --- two-factor authentication, privacy ----------------------------------------------------------------
AEGIS_MFA_REQUIRED_FOR_STAFF=false         # must be true in production (staff enrol a TOTP app)
AEGIS_CONVERSATION_RETENTION_DAYS=0        # erase the text of finished conversations after N days (0 = keep)

# --- payments (refund execution) -------------------------------------------------------------------------
AEGIS_PAYMENT_PROVIDER=simulated           # simulated (moves no money) | stripe (required in production)
# AEGIS_STRIPE_API_KEY=                    # a restricted key: refunds only
# AEGIS_STRIPE_WEBHOOK_SECRET=             # signing secret of the /api/v1/webhooks/stripe endpoint

# --- e-mail (password reset) --------------------------------------------------------------------------------
AEGIS_EMAIL_BACKEND=dev_mailbox            # dev_mailbox (writes to var/mailbox) | smtp | disabled
# AEGIS_SMTP_HOST=
# AEGIS_SMTP_USERNAME=
# AEGIS_SMTP_PASSWORD=

# --- Docker Compose only (read by docker-compose.yml, not by the application) -----------------------------
# POSTGRES_PASSWORD=                       # bootstrap superuser, used by the init script only
# AEGIS_DB_OWNER_PASSWORD=                 # schema owner, used by the migration job only
# AEGIS_DB_APP_PASSWORD=                   # runtime role used by the API and the worker
# REDIS_PASSWORD=
# QDRANT_API_KEY=
